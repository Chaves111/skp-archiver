# انسخ هذا الملف إلى .env وعدّل القيم (لا ترفع .env إلى Git أبداً).
# Copy to .env and adjust values. Never commit .env.

# مسار مجلد SketchUp داخل المشروع
SKP_PROJECT_ROOT=G:\My Drive\Projects\2026_Project_Name\06_3D_Models_Visuals\SketchUp

# تفعيل/تعطيل التنبيه البريدي المشروط
SKP_EMAIL_ENABLED=false

# إعدادات SMTP (Gmail يتطلب App Password وليس كلمة المرور العادية)
SKP_SMTP_SERVER=smtp.gmail.com
SKP_SMTP_PORT=587
SKP_SENDER_EMAIL=your_email@gmail.com
SKP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SKP_RECEIVER_EMAIL=your_email@gmail.com
